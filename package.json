{
  "name": "done-gate-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.9",
    "@changesets/cli": "3.0.3",
    "@types/node": "22.20.7",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  }
}
