{
  "name": "@mferret/done-gate",
  "version": "0.1.0",
  "description": "Stops an AI agent from declaring \"done\" until a check against the real system passes.",
  "license": "MIT",
  "author": "Martin Ferret",
  "homepage": "https://github.com/MartinFerret/done-gate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MartinFerret/done-gate.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/MartinFerret/done-gate/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "agents",
    "llm",
    "harness",
    "verification",
    "guardrail",
    "opentelemetry",
    "tracing"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1"
  }
}
