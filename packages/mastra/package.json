{
  "name": "@mferret/done-gate-mastra",
  "version": "0.0.0",
  "description": "done-gate for Mastra: a \"done\" tool the agent cannot pass until the check does.",
  "license": "MIT",
  "author": "Martin Ferret",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MartinFerret/done-gate.git",
    "directory": "packages/mastra"
  },
  "keywords": [
    "ai",
    "agent",
    "ai-sdk",
    "vercel",
    "verification"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@mastra/core": "^1.86.0",
    "@mferret/done-gate": "workspace:^",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@mastra/core": "1.86.0",
    "@mastra/observability": "1.24.3",
    "@mastra/otel-bridge": "1.6.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@mferret/done-gate": "workspace:*",
    "zod": "4.6.7"
  }
}
