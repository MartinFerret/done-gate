{
  "name": "@mferret/done-gate-ai-sdk",
  "version": "0.1.0",
  "description": "done-gate for the Vercel AI SDK: a \"done\" tool the agent cannot pass until the check does.",
  "license": "MIT",
  "author": "Martin Ferret",
  "homepage": "https://github.com/MartinFerret/done-gate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MartinFerret/done-gate.git",
    "directory": "packages/ai-sdk"
  },
  "bugs": {
    "url": "https://github.com/MartinFerret/done-gate/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "agents",
    "llm",
    "ai-sdk",
    "vercel",
    "verification",
    "guardrail",
    "done-gate"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "@mferret/done-gate": "^0.1.0"
  },
  "devDependencies": {
    "@ai-sdk/otel": "1.0.181",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "ai": "7.0.181",
    "@mferret/done-gate": "workspace:*"
  }
}
